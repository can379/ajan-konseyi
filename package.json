{
  "name": "ajan-konseyi",
  "version": "0.3.0",
  "description": "API kullanmadan yerel abonelik oturumlariyla calisan coklu yapay zeka is birligi sistemi (Claude Code + Codex + Antigravity)",
  "productName": "Ajan Konseyi",
  "author": "Selim Can",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can379/ajan-konseyi.git"
  },
  "homepage": "https://github.com/can379/ajan-konseyi#readme",
  "bugs": {
    "url": "https://github.com/can379/ajan-konseyi/issues"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.cjs",
    "desktop:clean": "node scripts/cleanup-builds.mjs",
    "desktop:build": "npm run desktop:clean && electron-packager . 'Ajan Konseyi' --platform=darwin --arch=arm64 --out=dist --overwrite --prune=true --no-asar --extra-resource=scripts --ignore='^/(dist[^/]*|release|runs|memory|uploads|generated|node_modules/.cache|.git|.agent|.claude)$' --icon=assets/AjanKonseyi-v2.icns --app-bundle-id=com.selim.ajankonseyi.desktop --app-version=0.3.0",
    "release:mac": "mkdir -p release && npm run desktop:build && codesign --force --deep --sign - --identifier com.selim.ajankonseyi.desktop 'dist/Ajan Konseyi-darwin-arm64/Ajan Konseyi.app' && ditto -c -k --sequesterRsrc --keepParent 'dist/Ajan Konseyi-darwin-arm64/Ajan Konseyi.app' 'release/Ajan-Konseyi-macOS-arm64.zip'",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/run-golden-evals.mjs",
    "test:e2e": "AJAN_E2E=1 node --test --test-concurrency=1 test/project-chat-menu.test.js test/tool-resizer.test.js",
    "test:all": "npm test && npm run test:e2e",
    "mcp": "node mcp-server.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^43.4.1"
  },
  "engines": {
    "node": ">=18"
  }
}
